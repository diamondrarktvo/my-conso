{
   "name": "my-conso",
   "version": "1.0.0",
   "main": "index.ts",
   "scripts": {
      "bones:generate": "npx boneyard-js build --native --out ./src/bones",
      "bones:watch": "npx boneyard-js build --native --out ./src/bones --watch",
      "dev": "npx expo start",
      "dev-client": "npx expo start --dev-client",
      "android": "npx expo run:android --device",
      "ios": "npx expo run:ios --device --port 8003",
      "web": "npx expo start --web",
      "doctor": "npx expo-doctor",
      "fix": "npx expo install --check",
      "typecheck": "tsc --noEmit",
      "lint": "eslint .",
      "test": "jest",
      "build:android:development": "eas build --profile development --platform android",
      "build:android:preview": "eas build --profile preview --platform android",
      "build:android:production": "eas build --profile production --platform android",
      "build:android:production-apk": "eas build --profile production-apk --platform android",
      "build:ios:preview": "eas build --profile preview --platform ios",
      "build:ios:production": "eas build --profile production --platform ios",
      "submit:android": "eas submit --profile production --platform android",
      "submit:ios": "eas submit --profile production --platform ios"
   },
   "dependencies": {
      "@expo/vector-icons": "^15.1.1",
      "@gorhom/bottom-sheet": "^5.2.8",
      "@react-navigation/elements": "^2.9.7",
      "@react-navigation/native": "^7.1.30",
      "@react-navigation/native-stack": "^7.14.4",
      "babel-preset-expo": "^55.0.10",
      "boneyard-js": "^1.7.0",
      "clsx": "^2.1.1",
      "expo": "~55.0.5",
      "expo-constants": "^55.0.7",
      "expo-dev-client": "~55.0.13",
      "expo-font": "^55.0.4",
      "expo-haptics": "^55.0.8",
      "expo-image": "~55.0.6",
      "expo-linear-gradient": "~55.0.8",
      "expo-linking": "~55.0.7",
      "expo-splash-screen": "^55.0.10",
      "expo-status-bar": "~55.0.4",
      "expo-symbols": "^55.0.5",
      "expo-system-ui": "^55.0.9",
      "i18next": "^26.0.3",
      "intl-pluralrules": "^2.0.1",
      "lucide-react-native": "^0.575.0",
      "react": "19.2.0",
      "react-dom": "19.2.0",
      "react-error-boundary": "^6.1.1",
      "react-i18next": "^17.0.2",
      "react-native": "0.83.2",
      "react-native-bottom-sheet-stack": "^1.11.0",
      "react-native-gesture-handler": "^2.28.0",
      "react-native-keyboard-controller": "1.20.7",
      "react-native-mmkv": "~4.1.2",
      "react-native-nitro-modules": "~0.33.2",
      "react-native-reanimated": "4.2.1",
      "react-native-safe-area-context": "~5.6.2",
      "react-native-screens": "~4.23.0",
      "react-native-svg": "15.15.3",
      "react-native-teleport": "^1.0.2",
      "react-native-toast-message": "^2.3.3",
      "react-native-worklets": "0.7.2",
      "tailwind-merge": "^3.5.0",
      "tailwindcss": "^4.2.1",
      "uniwind": "^1.3.2",
      "zustand": "^5.0.11"
   },
   "devDependencies": {
      "@testing-library/react-native": "^14.1.0",
      "@types/jest": "29.5.14",
      "@types/react": "~19.2.14",
      "eslint": "^9.39.5",
      "eslint-config-expo": "^55.0.0",
      "jest": "~29.7.0",
      "jest-expo": "~55.0.22",
      "react-test-renderer": "^19.2.0",
      "typescript": "~5.9.2"
   },
   "private": true
}
